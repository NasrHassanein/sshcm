# ~/.ssh/config — managed by hand since 2014
# Global defaults first (first match wins!)

Include ~/.ssh/config.d/*
IdentitiesOnly yes

   # an indented comment

# --- work ---
Host work-* !work-legacy
	HostName %h.corp.example.com
	User alice   
	# ProxyJump bastion
Host work-legacy
	HostName 10.0.0.9
