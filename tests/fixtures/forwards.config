# Every forwarding shape OpenSSH supports, plus agent/X11 forwarding.

Host db
    HostName 10.0.0.5
    LocalForward 5432 localhost:5432
    LocalForward 127.0.0.1:6379 cache.internal:6379

Host jump
    HostName 203.0.113.10
    DynamicForward 1080
    DynamicForward [::1]:1081
    RemoteForward 9000 localhost:3000
    RemoteForward 0 localhost:3001
    RemoteForward *:1090
    ForwardAgent yes

Host docker
    HostName docker.example
    LocalForward 2375 /var/run/docker.sock
    LocalForward /tmp/pg.sock db.internal:5432
    RemoteForward /tmp/remote.sock /tmp/local.sock
    ForwardX11 yes
    ForwardX11Trusted no

Host *
    ExitOnForwardFailure yes
