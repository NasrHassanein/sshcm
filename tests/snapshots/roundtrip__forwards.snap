---
source: tests/roundtrip.rs
expression: "outline(&Document::parse(&text))"
---
Global 0..2
  [Lf] comment "# Every forwarding shape OpenSSH supports, plus agent/X11 forwarding."
  [Lf] blank
Host 2..7
  [Lf] "Host" sep=" " value="db"
  [Lf] "HostName" sep=" " value="10.0.0.5"
  [Lf] "LocalForward" sep=" " value="5432 localhost:5432"
  [Lf] "LocalForward" sep=" " value="127.0.0.1:6379 cache.internal:6379"
  [Lf] blank
Host 7..16
  [Lf] "Host" sep=" " value="jump"
  [Lf] "HostName" sep=" " value="203.0.113.10"
  [Lf] "DynamicForward" sep=" " value="1080"
  [Lf] "DynamicForward" sep=" " value="[::1]:1081"
  [Lf] "RemoteForward" sep=" " value="9000 localhost:3000"
  [Lf] "RemoteForward" sep=" " value="0 localhost:3001"
  [Lf] "RemoteForward" sep=" " value="*:1090"
  [Lf] "ForwardAgent" sep=" " value="yes"
  [Lf] blank
Host 16..24
  [Lf] "Host" sep=" " value="docker"
  [Lf] "HostName" sep=" " value="docker.example"
  [Lf] "LocalForward" sep=" " value="2375 /var/run/docker.sock"
  [Lf] "LocalForward" sep=" " value="/tmp/pg.sock db.internal:5432"
  [Lf] "RemoteForward" sep=" " value="/tmp/remote.sock /tmp/local.sock"
  [Lf] "ForwardX11" sep=" " value="yes"
  [Lf] "ForwardX11Trusted" sep=" " value="no"
  [Lf] blank
Host 24..26
  [Lf] "Host" sep=" " value="*"
  [Lf] "ExitOnForwardFailure" sep=" " value="yes"
