---
source: tests/roundtrip.rs
expression: "outline(&Document::parse(&text))"
---
Global 0..0
Match 0..3
  [Lf] "Match" sep=" " value="host *.internal exec \"test -f ~/.vpn-up\""
  [Lf] "ProxyJump" sep=" " value="none"
  [Lf] blank
Match 3..9
  [Lf] "Match" sep=" " value="all"
  [Lf] "IdentityFile" sep=" " value="\"~/My Keys/id_rsa\""
  [Lf] "LocalForward" sep=" " value="8080 localhost:80"
  [Lf] "LocalForward" sep=" " value="8443 localhost:443"
  [Lf] blank
  [Lf] INVALID "=orphan value"
Host 9..10
  [Lf] "Host" sep="" value=""
